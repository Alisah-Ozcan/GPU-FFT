include(CMakeFindDependencyMacro)

find_dependency(CUDAToolkit REQUIRED)

# GPU architectures libfft is compiled for (CMAKE_CUDA_ARCHITECTURES of the
# GPU-FFT build).
set(GPUFFT_CUDA_ARCHITECTURES "@CMAKE_CUDA_ARCHITECTURES@")

include("${CMAKE_CURRENT_LIST_DIR}/@GPUFFT_TARGETS_EXPORT_NAME@.cmake")
